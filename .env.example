# Airtable — Personal Access Token with data.records:read/write and
# schema.bases:read scopes on the "claude.form-builder.database" base.
# Create one at https://airtable.com/create/tokens
VITE_AIRTABLE_TOKEN=

# Already fixed for this project's base — only change if you fork the base.
VITE_AIRTABLE_BASE_ID=appualgH3NCJzKMz3

# Password for the single Admin account. Client passwords are set/reset per
# account from the admin Clients page instead (stored in Airtable).
VITE_ADMIN_PASSWORD=
